# Template only: actual local credentials are in ignored .env.local.
DB_BACKEND=mysql
RESULTS_DATABASE_URL=mysql://USER:PERCENT_ENCODED_PASSWORD@127.0.0.1:33306/results_test
STUDENT_DATABASE_URL=mysql://USER:PERCENT_ENCODED_PASSWORD@127.0.0.1:33306/students_test
MYSQL_TLS_MODE=disabled
# Remote hosts require MYSQL_TLS_MODE=required and optionally MYSQL_TLS_CA_FILE.
MYSQL_POOL_LIMIT=5
MYSQL_QUEUE_LIMIT=64
MYSQL_CONNECT_TIMEOUT_MS=3000
MYSQL_ACQUIRE_TIMEOUT_MS=3000
MYSQL_QUERY_TIMEOUT_MS=7000
MYSQL_TRANSACTION_TIMEOUT_MS=12000
CLASSROOM_HTTP=true
APP_ORIGIN=http://127.0.0.1:3307
RESULTS_DB_PATH=private/unused-results.sqlite
STUDENT_DB_PATH=private/unused-students.sqlite
BACKUP_DIR=private/mysql-backups
STUDENT_MEDIA_DIR=private/learning-media
